# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB service name in Docker Compose or mongodb://127.0.0.1:27017/hercs_db for local)
MONGO_URI=mongodb://mongodb:27017/hercs_db

# Security & Authentication
JWT_SECRET=mayo-hercs-secure-jwt-secret-2026

# Hospital Information Management System (HMIS/FHIR) Integration API Key
INTEGRATION_API_KEY=mayo-hmis-secure-api-key-2026
