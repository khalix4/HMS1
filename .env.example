# =================================================================
# Mayo Emergency Resource Coordination System (HERCS)
# Environment Variables Configuration
# =================================================================

# Server / Backend
SERVER_PORT=5000
NODE_ENV=production
JWT_SECRET=mayo-hercs-secure-jwt-secret-2026
INTEGRATION_API_KEY=mayo-hmis-secure-api-key-2026

# Database
# For Docker Compose: mongodb service name is "mongodb"
# For Local Node run: mongodb://127.0.0.1:27017/hercs_db
MONGO_URI=mongodb://mongodb:27017/hercs_db
MONGO_PORT=27017

# Client / Frontend Host Ports
CLIENT_PORT=80
CLIENT_ALT_PORT=5173
